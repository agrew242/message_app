# HTTPS for the relay. Caddy gets and renews the certificate from Let's
# Encrypt on its own. No access logs are kept (there's no `log` directive).
{
	email {$CONTACT_EMAIL}
}

{$RELAY_DOMAIN} {
	tls {
		protocols tls1.3
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	reverse_proxy relay:8080
}
