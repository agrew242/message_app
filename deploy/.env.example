# Copy to .env and fill in. See SETUP.md.

# The relay's address: a DNS name pointing at this server.
RELAY_DOMAIN=relay.example.com

# Where the web app is served from, exactly as the browser shows it (no
# path, no trailing slash). With GitHub Pages and your own domain:
APP_ORIGIN=https://chat.example.com

# Let's Encrypt and the push services use this to reach you about problems.
CONTACT_EMAIL=you@example.com
